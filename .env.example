# Copy to .env for local runs. Docker Compose interpolates these with the defaults below.
# No secrets belong in git. Leave keys blank to run the extractive mock writer.

APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true

# Inside Compose these hosts are overridden to the service names.
DATABASE_URL=postgresql+asyncpg://vellum:vellum@localhost:5432/vellum
REDIS_URL=redis://localhost:6379/0

# groq | gemini | ollama | mock
# mock quotes retrieved sources and needs no key. Use it to boot the stack immediately.
LLM_PROVIDER=mock
# Blank uses a free-tier default for the selected provider.
LLM_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# hash (no download) | fastembed (local ONNX model, pip install .[embeddings])
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

MAX_SUBQUESTIONS=3
MAX_RESULTS_PER_PROVIDER=3
MAX_SOURCES_TOTAL=12
MAX_SOURCES_FOR_WRITER=8
MAX_REVISION_LOOPS=2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=6
SOURCE_STORE_CHARS=4000
SOURCE_PROMPT_CHARS=1600

SEARCH_RATE_LIMIT_RPS=1
SEARCH_TIMEOUT_SECONDS=20
CACHE_TTL_SECONDS=86400
# Optional. A free Semantic Scholar key raises the unauthenticated rate limit.
SEMANTIC_SCHOLAR_API_KEY=
# Optional. Unpaywall asks for a real email and has no key. Leave blank to skip it.
UNPAYWALL_EMAIL=

# Open-access PDFs from an allowlisted host. Failures keep the abstract.
FULLTEXT_ENABLED=true
FULLTEXT_MAX_PDFS=4
FULLTEXT_MAX_ATTEMPTS=6
FULLTEXT_MAX_PAGES=20
FULLTEXT_MAX_BYTES=12000000
FULLTEXT_MAX_CHARS=60000
FULLTEXT_MAX_CHUNKS=36
FULLTEXT_TIMEOUT_SECONDS=25
FULLTEXT_PROMPT_CHARS=2200

# arq runs the worker container. inline runs the graph inside the API process.
JOB_EXECUTOR=arq
# Public demo ceilings. Leave false for a private Compose stack.
DEMO_MODE=false
DEMO_MAX_JOBS_PER_HOUR=8
DEMO_MAX_JOBS_PER_IP_PER_HOUR=3

JOB_TIMEOUT_SECONDS=600
WORKER_MAX_JOBS=2
API_RATE_LIMIT_PER_MINUTE=60
JOB_RATE_LIMIT_PER_MINUTE=6

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=vellum

FRONTEND_DIR=
